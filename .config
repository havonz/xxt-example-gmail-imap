{
    "type": "xxt",
    "bid": "xxt-example-gmail-imap",
    "information": [
        [
            "Description",
            "通过IMAP协议接收Gmail邮件演示脚本"
        ],
        [
            "Version",
            "0.1.0"
        ]
    ],
    "name": "",
    "entitlements": {
        "allow-external-require": false
    },
    "ignores": [
        "/.dist",
        "/.git",
        "/xxtouch-script-guide.md",
        "/AGENTS.md",
        "/CLAUDE.md",
        "/GEMINI.md",
        "/lua/scripts/gmail_attachments",
        "/.agents"
    ],
    "buildIgnores": [
        "/lua/scripts/main.json",
        "/lua/scripts/gmail_attachments"
    ],
    "onEncryptSuccess": {
        "win32": "echo ${fileDirname}",
        "darwin": "echo ${fileDirname}",
        "default": "echo ${file}, ${fileDirname}, ${fileBasename}"
    },
    "libs": []
}
